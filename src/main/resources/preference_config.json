{
  "configs": [
    {
      "title": "音乐标签工作台",
      "config": "tag-workbench.json",
      "preferences": [
        {
          "key": "matching.skip_complete",
          "type": "switch",
          "title": "跳过已有完整标签的歌曲",
          "summary": "开启后，标题、艺术家、专辑、封面和歌词均不为空的歌曲不会再参与标签源匹配，避免覆盖现有内容",
          "default_value": false
        },
        {
          "type": "button",
          "title": "SPW 音乐文件夹",
          "summary": "选择并管理一个或多个音乐目录；打开工作台时自动扫描",
          "arrow_type": "arrow",
          "on_click": "com.smallsinger.spw.tags.TagWorkbenchPlugin.chooseLibraryFolder"
        },
        {
          "type": "button",
          "title": "打开标签工作台",
          "summary": "自动跟随当前播放歌曲，也可选择文件批量匹配、编辑和写入标签",
          "arrow_type": "arrow",
          "on_click": "com.smallsinger.spw.tags.TagWorkbenchPlugin.openWorkbench"
        },
        {
          "type": "button",
          "title": "开源项目",
          "summary": "查看源代码、使用说明与问题反馈",
          "arrow_type": "arrow",
          "on_click": "com.smallsinger.spw.tags.TagWorkbenchPlugin.openSourcePage"
        }
      ]
    }
  ]
}
