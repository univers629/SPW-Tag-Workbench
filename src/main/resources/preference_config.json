{
  "configs": [
    {
      "title": "音乐标签工作台",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "打开音乐标签工作台",
          "summary": "进入工作台主视图：批量处理匹配歌词、匹配封面、匹配艺术家，查看歌曲频谱、逐字打轴等",
          "arrow_type": "arrow",
          "on_click": "io.github.univers629.spwtagworkbench.MainPlugin.openWorkbench"
        },
        {
          "type": "button",
          "title": "快捷键设置",
          "summary": "在宿主的「设置 → 快捷键」中修改「打开音乐标签工作台」的键位，默认 Ctrl+Alt+T",
          "arrow_type": "none",
          "on_click": "io.github.univers629.spwtagworkbench.MainPlugin.showShortcutHint"
        },
        {
          "type": "list",
          "key": "matching.policy",
          "title": "批量匹配时的已有标签策略",
          "summary": "全部重新匹配：用在线数据覆盖完整标签；仅补缺失：完整标签整首跳过",
          "entries": [
            "全部重新匹配",
            "仅补缺失"
          ],
          "entry_values": [
            "refill",
            "fill"
          ],
          "default_value": "fill"
        },
        {
          "type": "list",
          "key": "tags.id3v2",
          "title": "ID3v2 写入格式",
          "summary": "ID3v2.3 + UTF-16 兼容性最好；ID3v2.4 + UTF-8 体积更小、新播放器支持更好",
          "entries": [
            "ID3v2.3 UTF-16（兼容性最好）",
            "ID3v2.4 UTF-8（体积更小）"
          ],
          "entry_values": [
            "23",
            "24"
          ],
          "default_value": "23"
        },
        {
          "type": "switch",
          "key": "sidebar.rail",
          "title": "显示侧栏悬浮按钮",
          "summary": "窗口右侧的全局侧边栏召唤按钮",
          "default_value": true
        },
        {
          "type": "switch",
          "key": "titlebar.entry",
          "title": "在顶部标题栏显示召唤按钮",
          "summary": "标题栏多一枚插件按钮，单击即执行下面的默认行为",
          "default_value": true
        },
        {
          "type": "list",
          "key": "titlebar.action",
          "title": "顶部按钮点击时的默认行为",
          "summary": "单击按钮直接执行所选项，不弹出菜单",
          "entries": [
            "打开工作台",
            "开合全局侧边栏"
          ],
          "entry_values": [
            "workbench",
            "sidebar"
          ],
          "default_value": "workbench"
        },
        {
          "type": "list",
          "key": "titlebar.position",
          "title": "顶部召唤按钮的位置",
          "summary": "排在宿主「快捷」按钮的左侧或右侧；宿主标题栏是固定一排，插件只能选择锚定哪个位置",
          "entries": [
            "快捷按钮左侧",
            "快捷按钮右侧"
          ],
          "entry_values": [
            "left",
            "right"
          ],
          "default_value": "left"
        },
        {
          "type": "switch",
          "key": "view.showArtistSlots",
          "title": "工作台主视图显示艺术家封面",
          "summary": "关闭后主封面下方不再显示艺术家封面槽位",
          "default_value": true
        },
        {
          "type": "button",
          "title": "开源项目",
          "summary": "查看源代码、使用说明与问题反馈",
          "arrow_type": "arrow",
          "on_click": "io.github.univers629.spwtagworkbench.MainPlugin.openSourcePage"
        }
      ]
    }
  ]
}
